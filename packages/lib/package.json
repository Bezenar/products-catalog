{
  "name": "lib",
  "version": "1.0.0",
  "private": true,
  "types": "./src/index.ts",
  "exports": {
    "./assets/styles/index.scss": "./src/assets/styles/index.scss",
    "./tokens.module.scss": {
      "types": "./src/assets/styles/tokens.module.scss.d.ts",
      "import": "./src/assets/styles/tokens.module.scss"
    },
    "./icons/*": {
      "types": "./src/assets/icons/*/index.tsx",
      "import": "./src/assets/icons/*/index.tsx"
    },
    "./utils/*": {
      "types": "./src/utils/*/index.ts",
      "import": "./src/utils/*/index.ts"
    },
    "./atoms/*": {
      "types": "./src/components/atoms/*/index.tsx",
      "import": "./src/components/atoms/*/index.tsx"
    },
    "./molecules/*": {
      "types": "./src/components/molecules/*/index.tsx",
      "import": "./src/components/molecules/*/index.tsx"
    },
    "./organisms/*": {
      "types": "./src/components/organisms/*/index.tsx",
      "import": "./src/components/organisms/*/index.tsx"
    },
    "./utilityTypes": {
      "types": "./src/utilityTypes.ts",
      "import": "./src/utilityTypes.ts"
    },
    "./hooks/*": {
      "types": "./src/hooks/*/index.ts",
      "import": "./src/hooks/*/index.ts"
    }
  },
  "scripts": {
    "sb": "storybook dev -p 6006",
    "sb:build": "storybook build",
    "test": "vitest run --config vite.config.ts --root ../.. packages/lib"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "storybook": "^10.6.1"
  }
}
