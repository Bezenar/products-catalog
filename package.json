{
  "name": "product list",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/lib"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:stage": "lint-staged --verbose",
    "preview": "vite preview",
    "test": "vitest run --bail=1 --passWithNoTests",
    "test:watch": "vitest --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sb": "npm run sb -w packages/lib",
    "sb:build": "npm run sb:build -w packages/lib",
    "build:prod": "vite build --mode production && npm run sb:prod -w packages/lib",
    "husky:init": "husky init && git checkout origin/main ./.husky",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,jsonc,css,scss,sass,md,mdx,html,yml,yaml}": "prettier --write"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.13.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-redux": "^9.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^10.10.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lightningcss": "^1.33.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "sass-embedded": "^1.105.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.4"
  }
}
